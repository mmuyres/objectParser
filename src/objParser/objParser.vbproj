<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace></RootNamespace>
    <AssemblyName>objParser</AssemblyName>
    <StartupObject>ObjParserCli.Program</StartupObject>
    <Description>Command-line front end for the ObjectParser token-map parser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectParser\ObjectParser.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ObjectParser.Tests" />
  </ItemGroup>

</Project>
