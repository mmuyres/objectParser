<?xml version="1.0" encoding="utf-8"?>
<!--
  Free-standing objParser.exe: one file, .NET runtime included, nothing to install.
  dotnet publish src/objParser -p:PublishProfile=win-x64
  Output: dist/win-x64/objParser.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- the referenced library still emits a .pdb; the exe is meant to stand alone -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedPdbs Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedPdbs)" />
  </Target>
</Project>
